# Copie para .env e preencha. NUNCA commite o .env.
# Cada variável: o que é · onde conseguir · obrigatória?

NODE_ENV=development
APP_URL=http://localhost:3000

# Banco · obrigatória
DATABASE_URL=postgresql://usuario:senha@localhost:5432/{{NOME_PROJETO}}

# Auth · obrigatória se houver login
AUTH_SECRET=

# IA (se usar) · somente servidor
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
